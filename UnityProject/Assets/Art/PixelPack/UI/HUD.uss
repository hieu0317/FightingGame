.hud { flex-direction: row; justify-content: space-between; padding-left: 14px; padding-right: 14px; color: #fff3cb; -unity-font-definition: url("Fonts/Inter-SemiBold.ttf"); }
.fighter { flex-direction:row; width:40%; } .portrait { width:60px;height:60px; } .p1 {background-image:url("portrait_long.png");} .p2 {background-image:url("portrait_bao.png");} .meters {flex-grow:1;} .track {height:14px;background-color:#3e2735;} .hp {height:100%;width:100%;background-color:#df4253;} .energy {height:8px;margin-top:4px;background-image:url("energy_fill.png");} .guard {height:5px;margin-top:4px;background-color:#e3b04b;} .rounds {flex-direction:row;} .pip {width:10px;height:10px;margin-top:4px;margin-right:4px;background-image:url("round_empty.png");} .clock {font-size:34px;-unity-font-style:bold;color:#ffdf8e;}